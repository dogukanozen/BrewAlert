{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.24/MicrosoftTeams.schema.json",
  "manifestVersion": "1.24",
  "version": "1.0.0",
  "id": "${TEAMS_APP_ID}",
  "developer": {
    "name": "BrewAlert",
    "websiteUrl": "https://github.com/dogukanozen/BrewAlert",
    "privacyUrl": "https://github.com/dogukanozen/BrewAlert",
    "termsOfUseUrl": "https://github.com/dogukanozen/BrewAlert"
  },
  "name": {
    "short": "BrewAlert",
    "full": "BrewAlert Notifications"
  },
  "description": {
    "short": "Sends brew-ready notifications.",
    "full": "Sends BrewAlert Adaptive Card notifications when a brew is ready."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#6F4E37",
  "bots": [
    {
      "botId": "${BOT_ID}",
      "scopes": [
        "personal",
        "team",
        "groupChat"
      ],
      "isNotificationOnly": true,
      "supportsFiles": false
    }
  ],
  "validDomains": []
}
