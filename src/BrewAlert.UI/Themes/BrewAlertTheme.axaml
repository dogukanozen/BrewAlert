<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/AmbientColors.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="BrewFontFamily">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BrewBackgroundBrush" Color="#0d0e0f" />
                    <SolidColorBrush x:Key="BrewSurfaceBrush" Color="#151618" />
                    <SolidColorBrush x:Key="BrewCardBrush" Color="#1d1f21" />
                    <SolidColorBrush x:Key="BrewLineBrush" Color="#303235" />
                    <SolidColorBrush x:Key="BrewTextPrimaryBrush" Color="#f1f1ee" />
                    <SolidColorBrush x:Key="BrewTextSecondaryBrush" Color="#a5a7a8" />
                    <SolidColorBrush x:Key="BrewPrimaryBrush" Color="#eeefeb" />
                    <SolidColorBrush x:Key="BrewPrimaryTextBrush" Color="#151618" />
                    <SolidColorBrush x:Key="BrewSecondaryBrush" Color="#a5a7a8" />
                    <SolidColorBrush x:Key="BrewAccentBrush" Color="#e2e4e0" />
                    <SolidColorBrush x:Key="BrewSuccessBrush" Color="#d0d6cd" />
                    <SolidColorBrush x:Key="BrewDangerBrush" Color="#e0dcd8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BrewBackgroundBrush" Color="#eeede8" />
                    <SolidColorBrush x:Key="BrewSurfaceBrush" Color="#e7e6e0" />
                    <SolidColorBrush x:Key="BrewCardBrush" Color="#dfdfd8" />
                    <SolidColorBrush x:Key="BrewLineBrush" Color="#c8cbc3" />
                    <SolidColorBrush x:Key="BrewTextPrimaryBrush" Color="#232524" />
                    <SolidColorBrush x:Key="BrewTextSecondaryBrush" Color="#60655f" />
                    <SolidColorBrush x:Key="BrewPrimaryBrush" Color="#2a2f2b" />
                    <SolidColorBrush x:Key="BrewPrimaryTextBrush" Color="#f1f1e9" />
                    <SolidColorBrush x:Key="BrewSecondaryBrush" Color="#60655f" />
                    <SolidColorBrush x:Key="BrewAccentBrush" Color="#333a33" />
                    <SolidColorBrush x:Key="BrewSuccessBrush" Color="#414b40" />
                    <SolidColorBrush x:Key="BrewDangerBrush" Color="#51443d" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BrewBackgroundBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BrewFontFamily}" />
    </Style>
    <Style Selector=":is(UserControl).brew-shell">
        <Setter Property="Background" Value="{DynamicResource BrewBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrewTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BrewFontFamily}" />
    </Style>
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.brew-primary">
        <Setter Property="Background" Value="{DynamicResource BrewPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrewPrimaryTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.brew-secondary, Button.brew-danger, Button.theme-option">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrewTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrewLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="15,10" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.theme-option.selected">
        <Setter Property="Background" Value="{DynamicResource BrewPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrewPrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrewPrimaryBrush}" />
    </Style>
    <Style Selector="Button.brew-nav-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrewTextSecondaryBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.brew-icon-button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="11" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrewLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.brew-title">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LetterSpacing" Value="-0.8" />
    </Style>
    <Style Selector="TextBlock.brew-subtitle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource BrewTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.brew-section">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.brew-eyebrow">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LetterSpacing" Value="1.7" />
        <Setter Property="Foreground" Value="{DynamicResource BrewTextSecondaryBrush}" />
    </Style>
    <Style Selector="Path.brew-icon">
        <Setter Property="Stroke" Value="{DynamicResource BrewTextPrimaryBrush}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Border.brew-panel">
        <Setter Property="Background" Value="{DynamicResource BrewSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrewLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.settings-section">
        <Setter Property="BorderBrush" Value="{DynamicResource BrewLineBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,20,0,0" />
    </Style>
    <Style Selector="Grid.home-layout">
        <Setter Property="RowSpacing" Value="16" />
        <Setter Property="ColumnSpacing" Value="24" />
    </Style>
    <Style Selector="StackPanel.home-intro">
        <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="TextBlock.home-title">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="LetterSpacing" Value="-1" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="ItemsControl.home-choices">
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="UniformGrid.profile-grid"><Setter Property="Columns" Value="2" /></Style>
    <Style Selector="Button.profile-choice">
        <Setter Property="Background" Value="{DynamicResource BrewSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrewTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrewLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="MinHeight" Value="150" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.home-history">
        <Setter Property="Grid.Row" Value="2" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrewLineBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,14,0,0" />
    </Style>
    <Style Selector=":is(UserControl).porcelain :is(UserControl).profile-page:not(.compact) StackPanel.home-intro">
        <Setter Property="Grid.ColumnSpan" Value="1" />
        <Setter Property="Grid.RowSpan" Value="2" />
    </Style>
    <Style Selector=":is(UserControl).porcelain :is(UserControl).profile-page:not(.compact) TextBlock.home-title">
        <Setter Property="FontSize" Value="52" />
        <Setter Property="MaxWidth" Value="290" />
    </Style>
    <Style Selector=":is(UserControl).porcelain :is(UserControl).profile-page:not(.compact) ItemsControl.home-choices">
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="1" />
    </Style>
    <Style Selector=":is(UserControl).porcelain UniformGrid.profile-grid">
        <Setter Property="Columns" Value="1" />
    </Style>
    <Style Selector=":is(UserControl).porcelain Button.profile-choice">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinHeight" Value="106" />
        <Setter Property="Padding" Value="0,16" />
    </Style>
    <Style Selector=":is(UserControl).porcelain :is(UserControl).profile-page:not(.compact) Border.home-history">
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="1" />
    </Style>
    <Style Selector=":is(UserControl).porcelain Border.session-panel">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector=":is(UserControl).profile-page.compact TextBlock.home-title"><Setter Property="FontSize" Value="29" /></Style>
    <Style Selector=":is(UserControl).active-page.compact UniformGrid.sessions-grid"><Setter Property="Columns" Value="1" /></Style>
    <Style Selector=":is(UserControl).brew-shell.compact TextBlock.header-date"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector=":is(UserControl).brew-shell.compact Border.app-chrome"><Setter Property="Padding" Value="12,4" /></Style>
    <Style Selector=":is(UserControl).brew-shell.compact TextBlock.brand"><Setter Property="FontSize" Value="16" /></Style>
    <Style Selector=":is(UserControl).brew-shell.compact Button.brew-nav-btn"><Setter Property="Padding" Value="8,8" /></Style>
    <Style Selector="TextBox, ComboBox">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Border.app-chrome"><Setter Property="Padding" Value="24,8" /></Style>
    <Style Selector="Button.brew-nav-btn:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrewTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.brand"><Setter Property="FontSize" Value="18" /></Style>
    <Style Selector="UniformGrid.sessions-grid"><Setter Property="Columns" Value="2" /></Style>
    <Style Selector="Border.settings-profiles"><Setter Property="Grid.Column" Value="1" /></Style>
    <Style Selector="Border.settings-notifications"><Setter Property="Grid.Row" Value="1" /></Style>
    <Style Selector="Border.settings-updates"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="1" /></Style>
    <Style Selector=":is(UserControl).settings-page.compact Border.settings-profiles">
        <Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" />
    </Style>
    <Style Selector=":is(UserControl).settings-page.compact Border.settings-notifications">
        <Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="2" />
    </Style>
    <Style Selector=":is(UserControl).settings-page.compact Border.settings-updates">
        <Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="3" />
    </Style>
</Styles>
