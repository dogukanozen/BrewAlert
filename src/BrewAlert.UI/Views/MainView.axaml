<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BrewAlert.UI.ViewModels" xmlns:views="using:BrewAlert.UI.Views"
             xmlns:media="using:BrewAlert.UI.Media" x:Class="BrewAlert.UI.Views.MainView"
             x:DataType="vm:MainWindowViewModel" Classes="brew-shell" Classes.porcelain="{Binding Appearance.IsPorcelain}"
             Classes.sumi="{Binding Appearance.IsSumi}" Classes.ibre="{Binding Appearance.IsIbre}"
             Classes.aizome="{Binding Appearance.IsAizome}">
    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Classes="app-chrome" BorderBrush="{DynamicResource BrewLineBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                    <TextBlock Text="brewalert" Classes="brand" FontWeight="Medium" LetterSpacing="-0.5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding CurrentDateTime}" Classes="brew-subtitle header-date"
                               VerticalAlignment="Center" Margin="0,0,18,0" FontSize="12" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                        <Button Content="{Binding HomeNavText}" Classes="brew-nav-btn" Command="{Binding NavigateHomeCommand}" />
                        <Button Content="{Binding ActiveNavText}" Classes="brew-nav-btn" Command="{Binding NavigateToProfilesCommand}" />
                    </StackPanel>
                    <Button Grid.Column="3" Classes="brew-icon-button" Command="{Binding NavigateToSettingsCommand}"
                            AutomationProperties.Name="{Binding SettingsNavText}">
                        <Viewbox Width="20" Height="20"><Path Data="{x:Static media:BrewIconGeometry.Gear}" Classes="brew-icon" /></Viewbox>
                    </Button>
                </Grid>
            </Border>
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BrewLineBrush}" BorderThickness="0,1,0,0" Padding="24,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{Binding NotificationHint}" Classes="brew-subtitle" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Content="{Binding IdleText}" Command="{Binding ShowAmbientCommand}"
                            IsEnabled="{Binding CanShowAmbient}" Classes="brew-nav-btn" FontSize="11" />
                </Grid>
            </Border>
            <ContentControl Content="{Binding CurrentView}" />
        </DockPanel>
        <Border IsVisible="{Binding IsUpdateToastVisible}" Background="{DynamicResource BrewSurfaceBrush}"
                BorderBrush="{DynamicResource BrewLineBrush}" BorderThickness="1" CornerRadius="12"
                Padding="18" Margin="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="290" ZIndex="100">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding UpdateToastMessage}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{Binding UpdateToastDismissText}" Classes="brew-secondary" Command="{Binding DismissUpdateCommand}" />
                    <Button Content="{Binding UpdateToastInstallText}" Classes="brew-primary" Command="{Binding InstallUpdateCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border IsVisible="{Binding Ambient.IsVisible}" ZIndex="300" Background="{DynamicResource BrewBackgroundBrush}"
                PointerPressed="OnAmbientPointerPressed">
            <views:AmbientOverlayView DataContext="{Binding Ambient}" />
        </Border>
    </Grid>
</UserControl>
