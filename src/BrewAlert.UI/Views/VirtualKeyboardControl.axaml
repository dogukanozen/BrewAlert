<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BrewAlert.UI.Views.VirtualKeyboardControl"
             x:Name="Root">
    <Border Classes="vk-container">
        <StackPanel Spacing="2">
            <Grid x:Name="Row1" />
            <Grid x:Name="Row2" />
            <Grid x:Name="Row3" />
            <Grid x:Name="Row4" />
        </StackPanel>
    </Border>
</UserControl>
