<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BrewAlert.UI.ViewModels" xmlns:media="using:BrewAlert.UI.Media"
             xmlns:views="using:BrewAlert.UI.Views" xmlns:conv="using:BrewAlert.UI.Converters" x:Class="BrewAlert.UI.Views.ProfileListView"
             x:DataType="vm:ProfileListViewModel" Classes="profile-page">
    <UserControl.Resources><conv:TimeSpanToStringConverter x:Key="Duration" /></UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Classes="home-layout" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="24,18,12,10">
            <StackPanel Classes="home-intro" Spacing="8" Margin="0,0,12,0">
                <TextBlock Text="{Binding HomeEyebrow}" Classes="brew-eyebrow" />
                <TextBlock Text="{Binding HomeTitle}" Classes="home-title" />
                <TextBlock Text="{Binding HomeSubtitle}" Classes="brew-subtitle" TextWrapping="Wrap" />
                <TextBlock Text="{Binding LoadingText}" Classes="brew-subtitle" IsVisible="{Binding IsLoading}" />
                <TextBlock Text="{Binding ProfilesErrorText}" Classes="brew-subtitle" TextWrapping="Wrap"
                           IsVisible="{Binding ProfilesErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Profiles}" Classes="home-choices">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Classes="profile-grid" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="profile-choice" Command="{Binding $parent[ItemsControl].((vm:ProfileListViewModel)DataContext).SelectProfileCommand}"
                                CommandParameter="{Binding}">
                            <views:ProfileChoiceGrid Classes="profile-content">
                                <TextBlock Text="{Binding Description}" Classes="brew-subtitle profile-description" TextTrimming="CharacterEllipsis" />
                                <Viewbox Classes="profile-icon">
                                    <Path Data="{Binding Icon, Converter={StaticResource BrewIcon}}" Classes="brew-icon" />
                                </Viewbox>
                                <TextBlock Text="{Binding Name}" Classes="profile-name" />
                                <TextBlock Text="{Binding BrewDuration, Converter={StaticResource Duration}}" Classes="brew-subtitle profile-duration" />
                                <Viewbox Classes="profile-arrow">
                                    <Path Data="{x:Static media:BrewIconGeometry.Arrow}" Classes="brew-icon" />
                                </Viewbox>
                            </views:ProfileChoiceGrid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="home-history" IsVisible="{Binding HasRecentBrews}" Margin="0,0,12,0">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding RecentBrewsLabel}" Classes="brew-eyebrow" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{Binding HistoryToggleText}" Classes="brew-nav-btn"
                                Command="{Binding ToggleHistoryCommand}" IsVisible="{Binding CanExpandHistory}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding DisplayedRecentBrews}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentBrewItem">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,22,10">
                                    <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding RelativeTime}" Classes="brew-subtitle" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
