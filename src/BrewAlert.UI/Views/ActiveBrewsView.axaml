<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BrewAlert.UI.ViewModels" xmlns:conv="using:BrewAlert.UI.Converters"
             xmlns:media="using:BrewAlert.UI.Media" x:Class="BrewAlert.UI.Views.ActiveBrewsView"
             x:DataType="vm:ActiveBrewsViewModel" Classes="active-page">
    <UserControl.Resources><conv:TimeSpanToStringConverter x:Key="Duration" /></UserControl.Resources>
    <DockPanel Margin="24,20,12,12">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,12,18">
            <TextBlock Text="{Binding Title}" Classes="brew-title" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="{Binding NewBrewButtonText}" Command="{Binding NewBrewCommand}" Classes="brew-secondary" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyStateText}" Classes="brew-subtitle" IsVisible="{Binding !HasItems}" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasItems}">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Classes="sessions-grid" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BrewItemViewModel">
                        <Border Classes="brew-panel session-panel" Margin="0,0,12,12" Padding="20">
                            <StackPanel Spacing="13">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                    <Viewbox Width="19" Height="19"><Path Data="{Binding ProfileIcon, Converter={StaticResource BrewIcon}}" Classes="brew-icon" /></Viewbox>
                                    <TextBlock Grid.Column="1" Text="{Binding ProfileName}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="brew-subtitle" FontSize="11" />
                                </Grid>
                                <TextBlock Text="{Binding Remaining, Converter={StaticResource Duration}}" FontSize="68"
                                           FontWeight="Light" LetterSpacing="-3" HorizontalAlignment="Center" />
                                <ProgressBar Value="{Binding Progress}" Maximum="1" Height="3" CornerRadius="0"
                                             Foreground="{DynamicResource BrewTextPrimaryBrush}" Background="{DynamicResource BrewLineBrush}" />
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Content="{Binding PauseButtonText}" Command="{Binding PauseCommand}" Classes="brew-primary" Margin="0,0,8,0">
                                        <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="IsRunning" /><Binding Path="!IsPaused" /></MultiBinding></Button.IsVisible>
                                    </Button>
                                    <Button Content="{Binding ResumeButtonText}" Command="{Binding ResumeCommand}" Classes="brew-primary" Margin="0,0,8,0">
                                        <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="IsRunning" /><Binding Path="IsPaused" /></MultiBinding></Button.IsVisible>
                                    </Button>
                                    <Button Content="{Binding CancelButtonText}" Command="{Binding CancelCommand}" Classes="brew-secondary" IsVisible="{Binding IsRunning}" />
                                    <Button Content="{Binding DismissButtonText}" Command="{Binding DismissCommand}" Classes="brew-primary" IsVisible="{Binding IsCompleted}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding NotificationStatus}" Classes="brew-subtitle" FontSize="12" TextWrapping="Wrap"
                                           IsVisible="{Binding NotificationStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
