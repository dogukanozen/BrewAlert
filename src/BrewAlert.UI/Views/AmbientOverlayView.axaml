<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BrewAlert.UI.ViewModels"
             xmlns:conv="using:BrewAlert.UI.Converters"
             x:Class="BrewAlert.UI.Views.AmbientOverlayView"
             x:DataType="vm:AmbientOverlayViewModel">

    <UserControl.Resources>
        <conv:AmbientFloatConverter x:Key="AmbientFloat" />
        <conv:AmbientPulseOpacityConverter x:Key="AmbientPulse" />
    </UserControl.Resources>

    <Panel>
        <!-- Layer 1: vertical gradient base — applied directly on the root Panel so
             we don't introduce an empty child Panel just to host a Background brush. -->
        <Panel.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#1d1d33" />
                <GradientStop Offset="0.55" Color="#15152a" />
                <GradientStop Offset="1" Color="#0b0b1a" />
            </LinearGradientBrush>
        </Panel.Background>

        <!-- Layer 2: feathered corner blobs (radial gradients fade to fully transparent) -->
        <Ellipse Width="520" Height="520"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-160,-200,0,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Offset="0" Color="#66e07c24" />
                    <GradientStop Offset="1" Color="#00e07c24" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="460" Height="460"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-140,-140"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Offset="0" Color="#55f0a500" />
                    <GradientStop Offset="1" Color="#00f0a500" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Floating brew icons (transform-only animation) -->
        <TextBlock Text="{Binding FloatIconA}"
                   FontSize="52"
                   Opacity="0.35"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="48,72,0,0"
                   RenderTransformOrigin="50%,50%">
            <TextBlock.RenderTransform>
                <TranslateTransform Y="{Binding AnimationPhase, Converter={StaticResource AmbientFloat}, ConverterParameter=0}" />
            </TextBlock.RenderTransform>
        </TextBlock>

        <TextBlock Text="{Binding FloatIconB}"
                   FontSize="44"
                   Opacity="0.28"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,120,56,0"
                   RenderTransformOrigin="50%,50%">
            <TextBlock.RenderTransform>
                <TranslateTransform Y="{Binding AnimationPhase, Converter={StaticResource AmbientFloat}, ConverterParameter=1}" />
            </TextBlock.RenderTransform>
        </TextBlock>

        <TextBlock Text="{Binding FloatIconC}"
                   FontSize="38"
                   Opacity="0.22"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,100"
                   RenderTransformOrigin="50%,50%">
            <TextBlock.RenderTransform>
                <TranslateTransform Y="{Binding AnimationPhase, Converter={StaticResource AmbientFloat}, ConverterParameter=2}" />
            </TextBlock.RenderTransform>
        </TextBlock>

        <!-- Pulsing halo: soft radial glow placed BELOW center so it hugs the hero
             icon, never the clock numbers. Replaces the old hard-bordered ring that
             used to sit straight behind the time. -->
        <Ellipse Width="320" Height="320"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="0,80,0,0"
                 IsHitTestVisible="False"
                 Opacity="{Binding AnimationPhase, Converter={StaticResource AmbientPulse}}">
            <Ellipse.Fill>
                <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Offset="0" Color="#80f0a500" />
                    <GradientStop Offset="0.55" Color="#33e07c24" />
                    <GradientStop Offset="1" Color="#00e07c24" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Margin="24,0"
                    MaxWidth="640">

            <TextBlock Text="{Binding ClockTime}"
                       FontSize="72"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrewTextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       LetterSpacing="2" />

            <TextBlock Text="{Binding HeroIcon}"
                       FontSize="64"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />

            <TextBlock Text="{Binding Headline}"
                       Classes="brew-title ambient-headline"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />

            <TextBlock Text="{Binding Subheadline}"
                       Classes="brew-subtitle"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Opacity="0.85"
                       MaxWidth="520" />
        </StackPanel>

        <TextBlock Text="{Binding TapHint}"
                   Classes="brew-subtitle"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,28"
                   Opacity="0.55"
                   FontSize="14" />
    </Panel>
</UserControl>
