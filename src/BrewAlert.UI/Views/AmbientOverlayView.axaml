<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BrewAlert.UI.ViewModels"
             xmlns:conv="using:BrewAlert.UI.Converters"
             x:Class="BrewAlert.UI.Views.AmbientOverlayView"
             x:DataType="vm:AmbientOverlayViewModel">

    <UserControl.Resources>
        <conv:AmbientDriftConverter x:Key="AmbientDrift" />
        <conv:AmbientIconConverter x:Key="AmbientIcon" />
    </UserControl.Resources>

    <!-- Smooth, compositor-driven idle motion (transform/opacity only, Pi-friendly). These
         run independently of the 500ms VM tick, so they never stutter with it. -->
    <UserControl.Styles>
        <!-- Concentric rings that slowly rotate around the hero icon. -->
        <Style Selector="Ellipse.ambient-ring-cw">
            <Style.Animations>
                <Animation Duration="0:0:32" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.ambient-ring-ccw">
            <Style.Animations>
                <Animation Duration="0:0:48" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Steam wisps that rise and fade on a loop above the hero. Staggered delays keep
             the three from puffing in unison. -->
        <Style Selector="Viewbox.ambient-wisp.delay-0">
            <Style.Animations>
                <Animation Duration="0:0:6" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="20" />
                    </KeyFrame>
                    <KeyFrame Cue="35%">
                        <Setter Property="Opacity" Value="0.22" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-70" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Viewbox.ambient-wisp.delay-2">
            <Style.Animations>
                <Animation Duration="0:0:6" Delay="0:0:2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="20" />
                    </KeyFrame>
                    <KeyFrame Cue="35%">
                        <Setter Property="Opacity" Value="0.22" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-70" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Viewbox.ambient-wisp.delay-4">
            <Style.Animations>
                <Animation Duration="0:0:6" Delay="0:0:4" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="20" />
                    </KeyFrame>
                    <KeyFrame Cue="35%">
                        <Setter Property="Opacity" Value="0.22" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-70" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Orbit mode: the ring spins one way while each icon counter-spins at the same rate,
             so the icons travel the circle but stay upright. Same duration + linear timing
             keeps the cancellation exact. -->
        <Style Selector="Grid.orbit-spin">
            <Style.Animations>
                <Animation Duration="0:0:26" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Viewbox.orbit-counter">
            <Style.Animations>
                <Animation Duration="0:0:26" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="-360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Hero icon "breathing" and the halo "pulse" are continuous compositor keyframe
             animations (SineEaseInOut), not sampled off the 500ms VM tick — so the scale and
             glow glide smoothly instead of stepping 8 times per cycle. -->
        <Style Selector="Viewbox.ambient-breathe">
            <Style.Animations>
                <Animation Duration="0:0:6" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.955" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.955" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.045" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.045" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.955" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.955" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.ambient-pulse">
            <Style.Animations>
                <Animation Duration="0:0:6" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.22" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.40" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.22" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Aurora mode: oversized translucent ribbons rotate at unrelated speeds. Their
             geometry stays simple, but the overlap produces a constantly changing backdrop. -->
        <Style Selector="Ellipse.aurora-a">
            <Style.Animations>
                <Animation Duration="0:0:18" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="-18" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="RotateTransform.Angle" Value="24" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="-18" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.aurora-b">
            <Style.Animations>
                <Animation Duration="0:0:24" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="28" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="RotateTransform.Angle" Value="-30" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="28" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.aurora-c">
            <Style.Animations>
                <Animation Duration="0:0:13" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.16" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.48" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.16" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Brew rain: three timing lanes are shared by many vector particles. -->
        <Style Selector="Viewbox.brew-rain-a">
            <Style.Animations>
                <Animation Duration="0:0:8" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="-18" />
                        <Setter Property="TranslateTransform.Y" Value="-180" />
                    </KeyFrame>
                    <KeyFrame Cue="15%"><Setter Property="Opacity" Value="0.62" /></KeyFrame>
                    <KeyFrame Cue="85%"><Setter Property="Opacity" Value="0.42" /></KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="42" />
                        <Setter Property="TranslateTransform.Y" Value="900" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Viewbox.brew-rain-b">
            <Style.Animations>
                <Animation Duration="0:0:11" Delay="0:0:2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="30" />
                        <Setter Property="TranslateTransform.Y" Value="-220" />
                    </KeyFrame>
                    <KeyFrame Cue="18%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
                    <KeyFrame Cue="82%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="-36" />
                        <Setter Property="TranslateTransform.Y" Value="900" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Viewbox.brew-rain-c">
            <Style.Animations>
                <Animation Duration="0:0:6" Delay="0:0:4" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-150" />
                    </KeyFrame>
                    <KeyFrame Cue="12%"><Setter Property="Opacity" Value="0.76" /></KeyFrame>
                    <KeyFrame Cue="88%"><Setter Property="Opacity" Value="0.5" /></KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="28" />
                        <Setter Property="TranslateTransform.Y" Value="900" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Kaleidoscope geometry rotates in opposing directions, creating a folding tunnel. -->
        <Style Selector="Border.kaleido-a">
            <Style.Animations>
                <Animation Duration="0:0:16" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.kaleido-b">
            <Style.Animations>
                <Animation Duration="0:0:11" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="45" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="-315" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.kaleido-c">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.18" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.62" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.18" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Meteor streaks cross the entire screen; staggered delays prevent a repeated volley. -->
        <Style Selector="Grid.meteor-a">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="-520" />
                        <Setter Property="TranslateTransform.Y" Value="-180" />
                    </KeyFrame>
                    <KeyFrame Cue="18%"><Setter Property="Opacity" Value="0.85" /></KeyFrame>
                    <KeyFrame Cue="75%"><Setter Property="Opacity" Value="0.65" /></KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="720" />
                        <Setter Property="TranslateTransform.Y" Value="420" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Grid.meteor-b">
            <Style.Animations>
                <Animation Duration="0:0:7" Delay="0:0:2.5" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="-660" />
                        <Setter Property="TranslateTransform.Y" Value="-300" />
                    </KeyFrame>
                    <KeyFrame Cue="20%"><Setter Property="Opacity" Value="0.65" /></KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="760" />
                        <Setter Property="TranslateTransform.Y" Value="500" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Grid.meteor-c">
            <Style.Animations>
                <Animation Duration="0:0:4" Delay="0:0:1.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="-460" />
                        <Setter Property="TranslateTransform.Y" Value="-260" />
                    </KeyFrame>
                    <KeyFrame Cue="15%"><Setter Property="Opacity" Value="0.92" /></KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="680" />
                        <Setter Property="TranslateTransform.Y" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Liquid mode: giant wave bodies slide horizontally while bubbles rise through them. -->
        <Style Selector="Ellipse.liquid-wave-a">
            <Style.Animations>
                <Animation Duration="0:0:12" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="-120" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="TranslateTransform.X" Value="120" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="-120" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.liquid-wave-b">
            <Style.Animations>
                <Animation Duration="0:0:17" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="150" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="TranslateTransform.X" Value="-150" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="150" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.liquid-bubble-a">
            <Style.Animations>
                <Animation Duration="0:0:7" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="220" /></KeyFrame>
                    <KeyFrame Cue="25%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="-480" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.liquid-bubble-b">
            <Style.Animations>
                <Animation Duration="0:0:9" Delay="0:0:3" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="260" /></KeyFrame>
                    <KeyFrame Cue="20%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="-520" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Hyperspace: short center streaks stretch rapidly into a luminous star tunnel. -->
        <Style Selector="Border.warp-streak-a">
            <Style.Animations>
                <Animation Duration="0:0:3.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="0.05" /></KeyFrame>
                    <KeyFrame Cue="20%"><Setter Property="Opacity" Value="0.8" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="4.5" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.warp-streak-b">
            <Style.Animations>
                <Animation Duration="0:0:4.4" Delay="0:0:1.1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="0.04" /></KeyFrame>
                    <KeyFrame Cue="18%"><Setter Property="Opacity" Value="0.62" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="5.2" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.warp-streak-c">
            <Style.Animations>
                <Animation Duration="0:0:2.6" Delay="0:0:0.6" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="0.08" /></KeyFrame>
                    <KeyFrame Cue="22%"><Setter Property="Opacity" Value="0.92" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="3.8" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Radar: scan rings expand from the clock while a targeting line sweeps around it. -->
        <Style Selector="Ellipse.radar-ring-a">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.72" /><Setter Property="ScaleTransform.ScaleX" Value="0.18" /><Setter Property="ScaleTransform.ScaleY" Value="0.18" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="2.8" /><Setter Property="ScaleTransform.ScaleY" Value="2.8" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.radar-ring-b">
            <Style.Animations>
                <Animation Duration="0:0:5" Delay="0:0:1.7" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.62" /><Setter Property="ScaleTransform.ScaleX" Value="0.18" /><Setter Property="ScaleTransform.ScaleY" Value="0.18" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="2.8" /><Setter Property="ScaleTransform.ScaleY" Value="2.8" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.radar-ring-c">
            <Style.Animations>
                <Animation Duration="0:0:5" Delay="0:0:3.4" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.52" /><Setter Property="ScaleTransform.ScaleX" Value="0.18" /><Setter Property="ScaleTransform.ScaleY" Value="0.18" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="2.8" /><Setter Property="ScaleTransform.ScaleY" Value="2.8" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Grid.radar-sweep">
            <Style.Animations>
                <Animation Duration="0:0:8" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Fireflies: independent warm particles wander and breathe across wide arcs. -->
        <Style Selector="Ellipse.firefly-a">
            <Style.Animations>
                <Animation Duration="0:0:9" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.12" /><Setter Property="TranslateTransform.X" Value="-80" /><Setter Property="TranslateTransform.Y" Value="40" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.9" /><Setter Property="TranslateTransform.X" Value="70" /><Setter Property="TranslateTransform.Y" Value="-90" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.12" /><Setter Property="TranslateTransform.X" Value="-80" /><Setter Property="TranslateTransform.Y" Value="40" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.firefly-b">
            <Style.Animations>
                <Animation Duration="0:0:13" Delay="0:0:2" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.08" /><Setter Property="TranslateTransform.X" Value="70" /><Setter Property="TranslateTransform.Y" Value="-50" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.72" /><Setter Property="TranslateTransform.X" Value="-100" /><Setter Property="TranslateTransform.Y" Value="100" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.08" /><Setter Property="TranslateTransform.X" Value="70" /><Setter Property="TranslateTransform.Y" Value="-50" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.firefly-c">
            <Style.Animations>
                <Animation Duration="0:0:7" Delay="0:0:1" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.1" /><Setter Property="TranslateTransform.X" Value="-30" /><Setter Property="TranslateTransform.Y" Value="-80" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.X" Value="95" /><Setter Property="TranslateTransform.Y" Value="70" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.1" /><Setter Property="TranslateTransform.X" Value="-30" /><Setter Property="TranslateTransform.Y" Value="-80" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Prism: triangular outlines counter-rotate while a central spectral glow pulses. -->
        <Style Selector="Polygon.prism-a">
            <Style.Animations>
                <Animation Duration="0:0:18" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Polygon.prism-b">
            <Style.Animations>
                <Animation Duration="0:0:12" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="30" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="-330" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.prism-glow">
            <Style.Animations>
                <Animation Duration="0:0:4" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.16" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.58" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.16" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- The base backdrop has three motion families. Mode changes now alter the silhouette
             of the whole screen instead of leaving the same corner blobs underneath every mode. -->
        <Style Selector="Ellipse.backdrop-organic-a">
            <Style.Animations>
                <Animation Duration="0:0:11" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.28" /><Setter Property="ScaleTransform.ScaleX" Value="0.82" /><Setter Property="ScaleTransform.ScaleY" Value="1.08" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.58" /><Setter Property="ScaleTransform.ScaleX" Value="1.14" /><Setter Property="ScaleTransform.ScaleY" Value="0.86" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.28" /><Setter Property="ScaleTransform.ScaleX" Value="0.82" /><Setter Property="ScaleTransform.ScaleY" Value="1.08" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.backdrop-organic-b">
            <Style.Animations>
                <Animation Duration="0:0:15" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.5" /><Setter Property="ScaleTransform.ScaleX" Value="1.12" /><Setter Property="ScaleTransform.ScaleY" Value="0.84" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.25" /><Setter Property="ScaleTransform.ScaleX" Value="0.86" /><Setter Property="ScaleTransform.ScaleY" Value="1.16" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.5" /><Setter Property="ScaleTransform.ScaleX" Value="1.12" /><Setter Property="ScaleTransform.ScaleY" Value="0.84" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.backdrop-organic-c">
            <Style.Animations>
                <Animation Duration="0:0:8" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.18" /><Setter Property="ScaleTransform.ScaleX" Value="0.72" /><Setter Property="ScaleTransform.ScaleY" Value="0.72" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.46" /><Setter Property="ScaleTransform.ScaleX" Value="1.18" /><Setter Property="ScaleTransform.ScaleY" Value="1.18" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.18" /><Setter Property="ScaleTransform.ScaleX" Value="0.72" /><Setter Property="ScaleTransform.ScaleY" Value="0.72" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Grid.backdrop-cosmic-a">
            <Style.Animations>
                <Animation Duration="0:0:30" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Grid.backdrop-cosmic-b">
            <Style.Animations>
                <Animation Duration="0:0:43" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.backdrop-cosmic-core">
            <Style.Animations>
                <Animation Duration="0:0:7" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.14" /><Setter Property="ScaleTransform.ScaleX" Value="0.76" /><Setter Property="ScaleTransform.ScaleY" Value="0.76" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.42" /><Setter Property="ScaleTransform.ScaleX" Value="1.22" /><Setter Property="ScaleTransform.ScaleY" Value="1.22" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.14" /><Setter Property="ScaleTransform.ScaleX" Value="0.76" /><Setter Property="ScaleTransform.ScaleY" Value="0.76" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.backdrop-prism-a">
            <Style.Animations>
                <Animation Duration="0:0:14" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.16" /><Setter Property="TranslateTransform.X" Value="-260" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.52" /><Setter Property="TranslateTransform.X" Value="260" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.16" /><Setter Property="TranslateTransform.X" Value="-260" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.backdrop-prism-b">
            <Style.Animations>
                <Animation Duration="0:0:19" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.46" /><Setter Property="TranslateTransform.X" Value="300" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.14" /><Setter Property="TranslateTransform.X" Value="-300" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.46" /><Setter Property="TranslateTransform.X" Value="300" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.backdrop-prism-c">
            <Style.Animations>
                <Animation Duration="0:0:9" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.08" /><Setter Property="TranslateTransform.X" Value="-160" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.38" /><Setter Property="TranslateTransform.X" Value="160" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.08" /><Setter Property="TranslateTransform.X" Value="-160" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Panel ClipToBounds="True" Opacity="{Binding ModeTransitionOpacity}">
        <Panel.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.45" />
            </Transitions>
        </Panel.Transitions>
        <!-- Layer 1: vertical gradient base. Bound to the rotating palette so the whole
             backdrop uses cached neutral tones from the active appearance. -->
        <Border Background="{Binding BackgroundBrush}">

        </Border>

        <!-- Organic backdrop: metaballs breathe, squash, and wander independently. -->
        <Panel IsVisible="{Binding IsOrganicBackdrop}" IsHitTestVisible="False">
            <Grid Width="670" Height="610" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-210,-230,0,0">
                <Grid.RenderTransform>
                    <TranslateTransform X="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=1:58}"
                                        Y="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=0:72}">
                        <TranslateTransform.Transitions><Transitions><DoubleTransition Property="X" Duration="0:0:0.5" /><DoubleTransition Property="Y" Duration="0:0:0.5" /></Transitions></TranslateTransform.Transitions>
                    </TranslateTransform>
                </Grid.RenderTransform>
                <Ellipse Classes="backdrop-organic-a" Fill="{Binding HaloBrush}" RenderTransformOrigin="50%,50%">
                    <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>

                </Ellipse>
            </Grid>
            <Grid Width="620" Height="560" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-190,-190">
                <Grid.RenderTransform>
                    <TranslateTransform X="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=3:52}"
                                        Y="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=2:64}">
                        <TranslateTransform.Transitions><Transitions><DoubleTransition Property="X" Duration="0:0:0.5" /><DoubleTransition Property="Y" Duration="0:0:0.5" /></Transitions></TranslateTransform.Transitions>
                    </TranslateTransform>
                </Grid.RenderTransform>
                <Ellipse Classes="backdrop-organic-b" Fill="{Binding GlowBottomBrush}" RenderTransformOrigin="50%,50%">
                    <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>

                </Ellipse>
            </Grid>
            <Grid Width="360" Height="330" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,110,90,0">
                <Grid.RenderTransform>
                    <TranslateTransform X="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=6:46}"
                                        Y="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=4:54}">
                        <TranslateTransform.Transitions><Transitions><DoubleTransition Property="X" Duration="0:0:0.5" /><DoubleTransition Property="Y" Duration="0:0:0.5" /></Transitions></TranslateTransform.Transitions>
                    </TranslateTransform>
                </Grid.RenderTransform>
                <Ellipse Classes="backdrop-organic-c" Fill="{Binding GlowTopBrush}" RenderTransformOrigin="50%,50%">
                    <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>

                </Ellipse>
            </Grid>
        </Panel>

        <!-- Cosmic backdrop: rotating elliptical light tracks orbit a breathing core. -->
        <Panel IsVisible="{Binding IsCosmicBackdrop}" IsHitTestVisible="False">
            <Ellipse Classes="backdrop-cosmic-core" Width="560" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Fill="{Binding HaloBrush}" RenderTransformOrigin="50%,50%">
                <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>

            </Ellipse>
            <Grid Classes="backdrop-cosmic-a" Width="980" Height="980" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                <Grid.RenderTransform><RotateTransform /></Grid.RenderTransform>
                <Ellipse Width="920" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="{Binding GlowTopBrush}" StrokeThickness="82" Opacity="0.34" />
                <Ellipse Width="760" Height="210" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="{Binding GlowBottomBrush}" StrokeThickness="28" Opacity="0.42" />
            </Grid>
            <Grid Classes="backdrop-cosmic-b" Width="900" Height="900" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                <Grid.RenderTransform><RotateTransform /></Grid.RenderTransform>
                <Ellipse Width="820" Height="360" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="{Binding HaloBrush}" StrokeThickness="34" StrokeDashArray="1,7" Opacity="0.4" />
            </Grid>
        </Panel>

        <!-- Prismatic backdrop: diagonal light planes slide in opposing directions. -->
        <Panel IsVisible="{Binding IsPrismaticBackdrop}" IsHitTestVisible="False">
            <Grid Width="1400" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransform="rotate(-22deg)">
                <Border Classes="backdrop-prism-a" Width="1150" Height="190" CornerRadius="999" Background="{Binding GlowTopBrush}">
                    <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>

                </Border>
            </Grid>
            <Grid Width="1400" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransform="rotate(18deg)">
                <Border Classes="backdrop-prism-b" Width="1220" Height="150" CornerRadius="999" Background="{Binding GlowBottomBrush}">
                    <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>

                </Border>
            </Grid>
            <Grid Width="1200" Height="170" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransform="rotate(64deg)">
                <Border Classes="backdrop-prism-c" Width="980" Height="92" CornerRadius="999" Background="{Binding HaloBrush}">
                    <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>

                </Border>
            </Grid>
        </Panel>

        <!-- Floating brew icons & particles — font-independent vector line art (orbit-like
             drift, transform-only). Grouped so they vanish cleanly when the DVD bounce takes
             the stage. -->
        <Panel IsVisible="{Binding IsCardMode}">
        <Viewbox Width="52" Height="52"
                 Opacity="0.35"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="48,72,0,0"
                 RenderTransformOrigin="50%,50%">
            <Viewbox.RenderTransform>
                <TranslateTransform X="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=4:10}"
                                    Y="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=0:14}">
                    <TranslateTransform.Transitions>
                        <Transitions>
                            <DoubleTransition Property="X" Duration="0:0:0.5" />
                            <DoubleTransition Property="Y" Duration="0:0:0.5" />
                        </Transitions>
                    </TranslateTransform.Transitions>
                </TranslateTransform>
            </Viewbox.RenderTransform>
            <Path Data="{Binding FloatIconA, Converter={StaticResource AmbientIcon}}"
                  Stroke="{DynamicResource BrewTextPrimaryBrush}" StrokeThickness="1.3"
                  StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
        </Viewbox>

        <Viewbox Width="44" Height="44"
                 Opacity="0.28"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,120,56,0"
                 RenderTransformOrigin="50%,50%">
            <Viewbox.RenderTransform>
                <TranslateTransform X="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=2:9}"
                                    Y="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=1:14}">
                    <TranslateTransform.Transitions>
                        <Transitions>
                            <DoubleTransition Property="X" Duration="0:0:0.5" />
                            <DoubleTransition Property="Y" Duration="0:0:0.5" />
                        </Transitions>
                    </TranslateTransform.Transitions>
                </TranslateTransform>
            </Viewbox.RenderTransform>
            <Path Data="{Binding FloatIconB, Converter={StaticResource AmbientIcon}}"
                  Stroke="{DynamicResource BrewTextPrimaryBrush}" StrokeThickness="1.3"
                  StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
        </Viewbox>

        <Viewbox Width="38" Height="38"
                 Opacity="0.22"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Margin="0,0,0,100"
                 RenderTransformOrigin="50%,50%">
            <Viewbox.RenderTransform>
                <TranslateTransform X="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=5:11}"
                                    Y="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=2:14}">
                    <TranslateTransform.Transitions>
                        <Transitions>
                            <DoubleTransition Property="X" Duration="0:0:0.5" />
                            <DoubleTransition Property="Y" Duration="0:0:0.5" />
                        </Transitions>
                    </TranslateTransform.Transitions>
                </TranslateTransform>
            </Viewbox.RenderTransform>
            <Path Data="{Binding FloatIconC, Converter={StaticResource AmbientIcon}}"
                  Stroke="{DynamicResource BrewTextPrimaryBrush}" StrokeThickness="1.3"
                  StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
        </Viewbox>

        <Viewbox Width="22" Height="22"
                 Opacity="0.20"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 Margin="120,0,0,0"
                 RenderTransformOrigin="50%,50%">
            <Viewbox.RenderTransform>
                <TranslateTransform X="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=6:8}"
                                    Y="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=3:14}">
                    <TranslateTransform.Transitions>
                        <Transitions>
                            <DoubleTransition Property="X" Duration="0:0:0.5" />
                            <DoubleTransition Property="Y" Duration="0:0:0.5" />
                        </Transitions>
                    </TranslateTransform.Transitions>
                </TranslateTransform>
            </Viewbox.RenderTransform>
            <Path Data="M12,3 C12.5,8 13,9 18,12 C13,15 12.5,16 12,21 C11.5,16 11,15 6,12 C11,9 11.5,8 12,3 Z"
                  Stroke="{DynamicResource BrewAccentBrush}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
        </Viewbox>

        <Viewbox Width="20" Height="20"
                 Opacity="0.18"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Margin="0,0,160,40"
                 RenderTransformOrigin="50%,50%">
            <Viewbox.RenderTransform>
                <TranslateTransform X="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=1:7}"
                                    Y="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=4:14}">
                    <TranslateTransform.Transitions>
                        <Transitions>
                            <DoubleTransition Property="X" Duration="0:0:0.5" />
                            <DoubleTransition Property="Y" Duration="0:0:0.5" />
                        </Transitions>
                    </TranslateTransform.Transitions>
                </TranslateTransform>
            </Viewbox.RenderTransform>
            <Path Data="M12,3 C12,3 6,11 6,15 A6,6 0 0 0 18,15 C18,11 12,3 12,3 Z"
                  Stroke="{DynamicResource BrewTextPrimaryBrush}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
        </Viewbox>
        </Panel>

        <!-- Aurora: broad luminous ribbons sweep through each other behind the clock. -->
        <Panel IsVisible="{Binding IsAuroraMode}" IsHitTestVisible="False">
            <Ellipse Classes="aurora-a"
                     Width="1100" Height="230"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0.6" RenderTransformOrigin="50%,50%">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Offset="0" Color="{DynamicResource AmbientColor00B4}" />
                        <GradientStop Offset="0.28" Color="{DynamicResource AmbientColor99B4}" />
                        <GradientStop Offset="0.62" Color="{DynamicResource AmbientColor889A}" />
                        <GradientStop Offset="1" Color="{DynamicResource AmbientColor009A}" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Classes="aurora-b"
                     Width="1000" Height="190"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0.52" RenderTransformOrigin="50%,50%">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Offset="0" Color="{DynamicResource AmbientColor0084}" />
                        <GradientStop Offset="0.32" Color="{DynamicResource AmbientColor8884}" />
                        <GradientStop Offset="0.68" Color="{DynamicResource AmbientColor998E}" />
                        <GradientStop Offset="1" Color="{DynamicResource AmbientColor008E}" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Classes="aurora-c"
                     Width="620" Height="620"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="{DynamicResource AmbientColor88D3}" />
                        <GradientStop Offset="0.4" Color="{DynamicResource AmbientColor33B4}" />
                        <GradientStop Offset="1" Color="{DynamicResource AmbientColor00B4}" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Viewbox Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="90,86,0,0" Opacity="0.7">
                <Path Data="M12,2 L14.5,9.5 L22,12 L14.5,14.5 L12,22 L9.5,14.5 L2,12 L9.5,9.5 Z"
                      Stroke="{DynamicResource BrewAccentBrush}" StrokeThickness="1.4" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,145,110,0" Opacity="0.65">
                <Path Data="M12,2 L14.5,9.5 L22,12 L14.5,14.5 L12,22 L9.5,14.5 L2,12 L9.5,9.5 Z"
                      Stroke="{DynamicResource BrewTextPrimaryBrush}" StrokeThickness="1.4" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,170,100" Opacity="0.55">
                <Path Data="M12,2 L14.5,9.5 L22,12 L14.5,14.5 L12,22 L9.5,14.5 L2,12 L9.5,9.5 Z"
                      Stroke="{DynamicResource BrewAccentBrush}" StrokeThickness="1.4" Fill="{x:Null}" />
            </Viewbox>
        </Panel>

        <!-- Brew rain: vector brew glyphs fall on independent depth lanes. -->
        <Panel IsVisible="{Binding IsBrewRainMode}" IsHitTestVisible="False">
            <Viewbox Classes="brew-rain-a" Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="70,0,0,0"><Viewbox.RenderTransform><TranslateTransform /></Viewbox.RenderTransform>
                <Path Data="{Binding FloatIconA, Converter={StaticResource AmbientIcon}}" Stroke="{DynamicResource BrewTextPrimaryBrush}"
                      StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Classes="brew-rain-b" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="190,0,0,0"><Viewbox.RenderTransform><TranslateTransform /></Viewbox.RenderTransform>
                <Path Data="{Binding FloatIconB, Converter={StaticResource AmbientIcon}}" Stroke="{DynamicResource BrewAccentBrush}"
                      StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Classes="brew-rain-c" Width="58" Height="58" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="310,0,0,0"><Viewbox.RenderTransform><TranslateTransform /></Viewbox.RenderTransform>
                <Path Data="{Binding FloatIconC, Converter={StaticResource AmbientIcon}}" Stroke="{DynamicResource BrewTextPrimaryBrush}"
                      StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Classes="brew-rain-b" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="-80,0,0,0"><Viewbox.RenderTransform><TranslateTransform /></Viewbox.RenderTransform>
                <Path Data="{Binding OrbitIconA, Converter={StaticResource AmbientIcon}}" Stroke="{DynamicResource BrewAccentBrush}"
                      StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Classes="brew-rain-a" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="150,0,0,0"><Viewbox.RenderTransform><TranslateTransform /></Viewbox.RenderTransform>
                <Path Data="{Binding OrbitIconB, Converter={StaticResource AmbientIcon}}" Stroke="{DynamicResource BrewTextPrimaryBrush}"
                      StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Classes="brew-rain-c" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,0,245,0"><Viewbox.RenderTransform><TranslateTransform /></Viewbox.RenderTransform>
                <Path Data="{Binding OrbitIconC, Converter={StaticResource AmbientIcon}}" Stroke="{DynamicResource BrewAccentBrush}"
                      StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Classes="brew-rain-b" Width="54" Height="54" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,0,110,0"><Viewbox.RenderTransform><TranslateTransform /></Viewbox.RenderTransform>
                <Path Data="{Binding OrbitIconD, Converter={StaticResource AmbientIcon}}" Stroke="{DynamicResource BrewTextPrimaryBrush}"
                      StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
        </Panel>

        <!-- Kaleidoscope: a neon geometric tunnel folds behind the fixed clock. -->
        <Panel IsVisible="{Binding IsKaleidoscopeMode}" IsHitTestVisible="False">
            <Border Classes="kaleido-a" Width="560" Height="560" BorderBrush="{DynamicResource AmbientBrush44B4}" BorderThickness="3"
                    CornerRadius="90" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                <Border.RenderTransform><RotateTransform /></Border.RenderTransform>
            </Border>
            <Border Classes="kaleido-b" Width="450" Height="450" BorderBrush="{DynamicResource AmbientBrush558E}" BorderThickness="3"
                    CornerRadius="72" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                <Border.RenderTransform><RotateTransform /></Border.RenderTransform>
            </Border>
            <Border Classes="kaleido-a" Width="340" Height="340" BorderBrush="{DynamicResource AmbientBrush669A}" BorderThickness="2.5"
                    CornerRadius="56" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                <Border.RenderTransform><RotateTransform /></Border.RenderTransform>
            </Border>
            <Border Classes="kaleido-b" Width="240" Height="240" BorderBrush="{DynamicResource AmbientBrush77D3}" BorderThickness="2"
                    CornerRadius="42" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                <Border.RenderTransform><RotateTransform /></Border.RenderTransform>
            </Border>
            <Border Classes="kaleido-c" Width="640" Height="640" BorderBrush="{DynamicResource AmbientBrush4484}" BorderThickness="6"
                    CornerRadius="110" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
            </Border>
            <Ellipse Width="210" Height="210" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.32">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="{DynamicResource AmbientColor77A9}" />
                        <GradientStop Offset="1" Color="{DynamicResource AmbientColor00A9}" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Panel>

        <!-- Meteor shower: bright streaks fly diagonally across different screen lanes. -->
        <Panel IsVisible="{Binding IsMeteorMode}" IsHitTestVisible="False">
            <Grid Classes="meteor-a" Width="280" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="20,80,0,0"><Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <Grid RenderTransform="rotate(24deg)">
                    <Border Height="3" CornerRadius="99">
                        <Border.Background><LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Offset="0" Color="{DynamicResource AmbientColor00A9}" /><GradientStop Offset="0.72" Color="{DynamicResource AmbientColorAAA9}" />
                            <GradientStop Offset="1" Color="{DynamicResource AmbientColorFFDF}" />
                        </LinearGradientBrush></Border.Background>
                    </Border>
                </Grid>
            </Grid>
            <Grid Classes="meteor-b" Width="360" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="0,230,0,0"><Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <Grid RenderTransform="rotate(24deg)">
                    <Border Height="2.5" CornerRadius="99">
                        <Border.Background><LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Offset="0" Color="{DynamicResource AmbientColor009A}" /><GradientStop Offset="0.7" Color="{DynamicResource AmbientColorAA9A}" />
                            <GradientStop Offset="1" Color="{DynamicResource AmbientColorFFFF}" />
                        </LinearGradientBrush></Border.Background>
                    </Border>
                </Grid>
            </Grid>
            <Grid Classes="meteor-c" Width="210" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="40,390,0,0"><Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <Grid RenderTransform="rotate(24deg)">
                    <Border Height="3.5" CornerRadius="99">
                        <Border.Background><LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Offset="0" Color="{DynamicResource AmbientColor008E}" /><GradientStop Offset="0.68" Color="{DynamicResource AmbientColorBB8E}" />
                            <GradientStop Offset="1" Color="{DynamicResource AmbientColorFFFF}" />
                        </LinearGradientBrush></Border.Background>
                    </Border>
                </Grid>
            </Grid>
            <Grid Classes="meteor-b" Width="240" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="0,520,0,0"><Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <Grid RenderTransform="rotate(24deg)">
                    <Border Height="2" Background="{DynamicResource AmbientBrushCCB4}" CornerRadius="99" />
                </Grid>
            </Grid>
        </Panel>

        <!-- Liquid: overlapping brew-coloured wave bodies roll while bubbles rise. -->
        <Panel IsVisible="{Binding IsLiquidMode}" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Classes="liquid-wave-b" Width="1300" Height="640"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-410" Opacity="0.42">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="{DynamicResource AmbientColorBB2F}" />
                        <GradientStop Offset="0.5" Color="{DynamicResource AmbientColorAA9A}" />
                        <GradientStop Offset="1" Color="{DynamicResource AmbientColor88B4}" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Classes="liquid-wave-a" Width="1200" Height="560"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-350" Opacity="0.58">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="{DynamicResource AmbientColorCC20}" />
                        <GradientStop Offset="0.45" Color="{DynamicResource AmbientColorCCA9}" />
                        <GradientStop Offset="1" Color="{DynamicResource AmbientColorAA8E}" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Classes="liquid-bubble-a" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="95,0,0,70" Stroke="{DynamicResource AmbientBrush99FF}" StrokeThickness="2" Fill="{DynamicResource AmbientBrush11FF}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Classes="liquid-bubble-b" Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="220,0,0,30" Stroke="{DynamicResource AmbientBrush77FF}" StrokeThickness="2" Fill="{DynamicResource AmbientBrush11FF}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Classes="liquid-bubble-a" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                     Margin="-90,0,0,50" Stroke="{DynamicResource AmbientBrush88FF}" StrokeThickness="1.5" Fill="{DynamicResource AmbientBrush11FF}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Classes="liquid-bubble-b" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                     Margin="140,0,0,20" Stroke="{DynamicResource AmbientBrush77FF}" StrokeThickness="2" Fill="{DynamicResource AmbientBrush11FF}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Classes="liquid-bubble-a" Width="46" Height="46" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,160,10" Stroke="{DynamicResource AmbientBrush66FF}" StrokeThickness="2" Fill="{DynamicResource AmbientBrush11FF}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            </Ellipse>
        </Panel>

        <!-- Hyperspace: radial streaks accelerate away from the clock in layered colours. -->
        <Panel IsVisible="{Binding IsHyperspaceMode}" IsHitTestVisible="False">
            <Ellipse Width="600" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="{DynamicResource AmbientColorCC06}" />
                        <GradientStop Offset="0.28" Color="{DynamicResource AmbientColor8821}" />
                        <GradientStop Offset="1" Color="{DynamicResource AmbientColor0021}" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Grid Width="360" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransform="rotate(0deg)">
                <Border Classes="warp-streak-a" Width="160" Height="3" CornerRadius="99" Background="{DynamicResource AmbientBrushDD9A}"
                        RenderTransformOrigin="50%,50%"><Border.RenderTransform><ScaleTransform /></Border.RenderTransform></Border>
            </Grid>
            <Grid Width="360" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransform="rotate(30deg)">
                <Border Classes="warp-streak-b" Width="135" Height="2" CornerRadius="99" Background="{DynamicResource AmbientBrushCCB4}"
                        RenderTransformOrigin="50%,50%"><Border.RenderTransform><ScaleTransform /></Border.RenderTransform></Border>
            </Grid>
            <Grid Width="360" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransform="rotate(60deg)">
                <Border Classes="warp-streak-c" Width="175" Height="3" CornerRadius="99" Background="{DynamicResource AmbientBrushEE8E}"
                        RenderTransformOrigin="50%,50%"><Border.RenderTransform><ScaleTransform /></Border.RenderTransform></Border>
            </Grid>
            <Grid Width="360" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransform="rotate(90deg)">
                <Border Classes="warp-streak-b" Width="150" Height="2" CornerRadius="99" Background="{DynamicResource AmbientBrushCCD3}"
                        RenderTransformOrigin="50%,50%"><Border.RenderTransform><ScaleTransform /></Border.RenderTransform></Border>
            </Grid>
            <Grid Width="360" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransform="rotate(120deg)">
                <Border Classes="warp-streak-a" Width="170" Height="3" CornerRadius="99" Background="{DynamicResource AmbientBrushDD84}"
                        RenderTransformOrigin="50%,50%"><Border.RenderTransform><ScaleTransform /></Border.RenderTransform></Border>
            </Grid>
            <Grid Width="360" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransform="rotate(150deg)">
                <Border Classes="warp-streak-c" Width="125" Height="2.5" CornerRadius="99" Background="{DynamicResource AmbientBrushEEA9}"
                        RenderTransformOrigin="50%,50%"><Border.RenderTransform><ScaleTransform /></Border.RenderTransform></Border>
            </Grid>
            <Ellipse Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource AmbientBrushCCFF}" />
        </Panel>

        <!-- Radar pulse: expanding rings, crosshairs, and a rotating spectral scan arm. -->
        <Panel IsVisible="{Binding IsRadarMode}" IsHitTestVisible="False">
            <Ellipse Width="520" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Stroke="{DynamicResource AmbientBrush22B4}" StrokeThickness="1" StrokeDashArray="3,8" />
            <Ellipse Width="360" Height="360" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Stroke="{DynamicResource AmbientBrush33B4}" StrokeThickness="1" StrokeDashArray="2,6" />
            <Ellipse Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Stroke="{DynamicResource AmbientBrush44B4}" StrokeThickness="1" StrokeDashArray="1,5" />
            <Border Width="620" Height="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource AmbientBrush22B4}" />
            <Border Width="1" Height="620" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource AmbientBrush22B4}" />
            <Ellipse Classes="radar-ring-a" Width="190" Height="190" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Stroke="{DynamicResource AmbientBrushAAB4}" StrokeThickness="3" Fill="{x:Null}" RenderTransformOrigin="50%,50%">
                <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Classes="radar-ring-b" Width="190" Height="190" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Stroke="{DynamicResource AmbientBrush889A}" StrokeThickness="2.5" Fill="{x:Null}" RenderTransformOrigin="50%,50%">
                <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Classes="radar-ring-c" Width="190" Height="190" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Stroke="{DynamicResource AmbientBrush88D3}" StrokeThickness="2" Fill="{x:Null}" RenderTransformOrigin="50%,50%">
                <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Grid Classes="radar-sweep" Width="520" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                  RenderTransformOrigin="50%,50%">
                <Grid.RenderTransform><RotateTransform /></Grid.RenderTransform>
                <Border Width="250" Height="3" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="99">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Offset="0" Color="{DynamicResource AmbientColor00B4}" />
                            <GradientStop Offset="0.55" Color="{DynamicResource AmbientColor77B4}" />
                            <GradientStop Offset="1" Color="{DynamicResource AmbientColorFFED}" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Panel>

        <!-- Fireflies: warm particles drift on different paths and pulse independently. -->
        <Panel IsVisible="{Binding IsFirefliesMode}" IsHitTestVisible="False">
            <Ellipse Classes="firefly-a" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="100,100,0,0" Fill="{DynamicResource AmbientBrushFFD3}"><Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform></Ellipse>
            <Ellipse Classes="firefly-b" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Margin="180,0,0,80" Fill="{DynamicResource AmbientBrushFFA9}"><Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform></Ellipse>
            <Ellipse Classes="firefly-c" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="85,0,0,120" Fill="{DynamicResource AmbientBrushFFEE}"><Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform></Ellipse>
            <Ellipse Classes="firefly-b" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="-150,75,0,0" Fill="{DynamicResource AmbientBrushFFB4}"><Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform></Ellipse>
            <Ellipse Classes="firefly-a" Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="120,145,0,0" Fill="{DynamicResource AmbientBrushFFD3}"><Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform></Ellipse>
            <Ellipse Classes="firefly-c" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                     Margin="-80,0,0,90" Fill="{DynamicResource AmbientBrushFFB0}"><Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform></Ellipse>
            <Ellipse Classes="firefly-a" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,115,130,0" Fill="{DynamicResource AmbientBrushFFD3}"><Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform></Ellipse>
            <Ellipse Classes="firefly-c" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Margin="0,70,210,0" Fill="{DynamicResource AmbientBrushFF9A}"><Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform></Ellipse>
            <Ellipse Classes="firefly-b" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,90,135" Fill="{DynamicResource AmbientBrushFFA9}"><Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform></Ellipse>
            <Ellipse Width="520" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.28">
                <Ellipse.Fill>
                    <RadialGradientBrush><GradientStop Offset="0" Color="{DynamicResource AmbientColor44D3}" /><GradientStop Offset="1" Color="{DynamicResource AmbientColor00D3}" /></RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Panel>

        <!-- Prism: spectral triangular echoes counter-rotate around a pulsing core. -->
        <Panel IsVisible="{Binding IsPrismMode}" IsHitTestVisible="False">
            <Ellipse Classes="prism-glow" Width="500" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="{DynamicResource AmbientColor77FF}" />
                        <GradientStop Offset="0.3" Color="{DynamicResource AmbientColor559A}" />
                        <GradientStop Offset="0.62" Color="{DynamicResource AmbientColor338E}" />
                        <GradientStop Offset="1" Color="{DynamicResource AmbientColor008E}" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Polygon Classes="prism-a" Points="260,8 512,470 8,470" Width="520" Height="480" Stretch="Fill"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AmbientBrush889A}" StrokeThickness="3"
                     Fill="{x:Null}" RenderTransformOrigin="50%,50%">
                <Polygon.RenderTransform><RotateTransform /></Polygon.RenderTransform>
            </Polygon>
            <Polygon Classes="prism-b" Points="230,8 452,410 8,410" Width="460" Height="420" Stretch="Fill"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AmbientBrush998E}" StrokeThickness="3"
                     Fill="{x:Null}" RenderTransformOrigin="50%,50%">
                <Polygon.RenderTransform><RotateTransform /></Polygon.RenderTransform>
            </Polygon>
            <Polygon Classes="prism-a" Points="180,8 352,320 8,320" Width="360" Height="330" Stretch="Fill"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AmbientBrushAAA9}" StrokeThickness="2.5"
                     Fill="{x:Null}" RenderTransformOrigin="50%,50%">
                <Polygon.RenderTransform><RotateTransform /></Polygon.RenderTransform>
            </Polygon>
            <Polygon Classes="prism-b" Points="125,8 242,220 8,220" Width="250" Height="230" Stretch="Fill"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AmbientBrushAAB4}" StrokeThickness="2"
                     Fill="{x:Null}" RenderTransformOrigin="50%,50%">
                <Polygon.RenderTransform><RotateTransform /></Polygon.RenderTransform>
            </Polygon>
        </Panel>

        <!-- Pulsing halo: soft radial glow placed BELOW center so it hugs the hero
             icon, never the clock numbers. Recolours with the palette. -->
        <Ellipse Classes="ambient-pulse"
                 Width="320" Height="320"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="0,80,0,0"
                 IsHitTestVisible="False"
                 Fill="{Binding HaloBrush}">

        </Ellipse>

        <!-- Slowly counter-rotating dashed rings + rising steam wisps encircle the hero icon.
             Card mode only; pure compositor transforms so the Pi stays smooth. -->
        <Panel IsVisible="{Binding IsCardMode}">
            <Ellipse Classes="ambient-ring-cw"
                     Width="208" Height="208"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="0,92,0,0"
                     Opacity="0.16"
                     IsHitTestVisible="False"
                     Stroke="{DynamicResource BrewTextPrimaryBrush}"
                     StrokeThickness="1.4"
                     StrokeDashArray="2,7"
                     RenderTransformOrigin="50%,50%">
                <Ellipse.RenderTransform>
                    <RotateTransform />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Classes="ambient-ring-ccw"
                     Width="150" Height="150"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="0,92,0,0"
                     Opacity="0.18"
                     IsHitTestVisible="False"
                     Stroke="{DynamicResource BrewAccentBrush}"
                     StrokeThickness="1.2"
                     StrokeDashArray="1,9"
                     RenderTransformOrigin="50%,50%">
                <Ellipse.RenderTransform>
                    <RotateTransform />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Viewbox Classes="ambient-wisp delay-0"
                     Width="24" Height="24"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="0,40,0,0"
                     IsHitTestVisible="False">
                <Viewbox.RenderTransform>
                    <TranslateTransform />
                </Viewbox.RenderTransform>
                <Path Data="M3,8 H13 A3,3 0 1 0 10,5 M3,13 H17 A3,3 0 1 1 14,16 M3,18 H11"
                      Stroke="{DynamicResource BrewTextPrimaryBrush}" StrokeThickness="1.4"
                      StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Classes="ambient-wisp delay-2"
                     Width="18" Height="18"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="64,30,0,0"
                     IsHitTestVisible="False">
                <Viewbox.RenderTransform>
                    <TranslateTransform />
                </Viewbox.RenderTransform>
                <Path Data="M12,3 C12.5,8 13,9 18,12 C13,15 12.5,16 12,21 C11.5,16 11,15 6,12 C11,9 11.5,8 12,3 Z"
                      Stroke="{DynamicResource BrewAccentBrush}" StrokeThickness="1.6"
                      StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Classes="ambient-wisp delay-4"
                     Width="20" Height="20"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="0,48,76,0"
                     IsHitTestVisible="False">
                <Viewbox.RenderTransform>
                    <TranslateTransform />
                </Viewbox.RenderTransform>
                <Path Data="M3,8 H13 A3,3 0 1 0 10,5 M3,13 H17 A3,3 0 1 1 14,16 M3,18 H11"
                      Stroke="{DynamicResource BrewTextPrimaryBrush}" StrokeThickness="1.4"
                      StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
        </Panel>

        <!-- DVD mode dims the lively backdrop so the bouncing logo reads clearly. Sits above
             the animated background but below the clock, so the clock stays bright and fixed. -->
        <Border Background="{DynamicResource AmbientBrushFF00}"
                IsHitTestVisible="False"
                Opacity="{Binding DvdDimOpacity}">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.8" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <!-- Orbit stays outside the clock/date clearance region, including on narrow screens. -->
        <Grid x:Name="OrbitStage" Classes="orbit-spin"
              IsVisible="{Binding IsOrbitMode}"
              Width="388" Height="388"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              IsHitTestVisible="False"
              RenderTransformOrigin="50%,50%">
            <Grid.RenderTransform>
                <RotateTransform />
            </Grid.RenderTransform>
            <Ellipse x:Name="OrbitRing" Margin="16" Stroke="{DynamicResource BrewLineBrush}" StrokeThickness="1" />
            <Viewbox Classes="orbit-counter" Width="32" Height="32"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0.7"
                     RenderTransformOrigin="50%,50%">
                <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                <Path Data="{Binding OrbitIconA, Converter={StaticResource AmbientIcon}}"
                      Stroke="{DynamicResource BrewTextPrimaryBrush}" StrokeThickness="1.3"
                      StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Classes="orbit-counter" Width="32" Height="32"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7"
                     RenderTransformOrigin="50%,50%">
                <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                <Path Data="{Binding OrbitIconB, Converter={StaticResource AmbientIcon}}"
                      Stroke="{DynamicResource BrewAccentBrush}" StrokeThickness="1.3"
                      StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Classes="orbit-counter" Width="32" Height="32"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0.7"
                     RenderTransformOrigin="50%,50%">
                <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                <Path Data="{Binding OrbitIconC, Converter={StaticResource AmbientIcon}}"
                      Stroke="{DynamicResource BrewTextPrimaryBrush}" StrokeThickness="1.3"
                      StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Classes="orbit-counter" Width="32" Height="32"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.7"
                     RenderTransformOrigin="50%,50%">
                <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                <Path Data="{Binding OrbitIconD, Converter={StaticResource AmbientIcon}}"
                      Stroke="{DynamicResource BrewAccentBrush}" StrokeThickness="1.3"
                      StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
        </Grid>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Margin="24,0"
                    MaxWidth="640">

            <TextBlock x:Name="AmbientClock" Text="{Binding ClockTime}"
                       FontSize="88"
                       FontWeight="Light"
                       Foreground="{DynamicResource BrewTextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       LetterSpacing="-3" />

            <!-- Localised date under the clock — always on (every mode), like the clock.
                 Sits tight beneath the time; negative top margin trims the parent spacing. -->
            <TextBlock x:Name="AmbientDate" Text="{Binding ClockDate}"
                       FontSize="14"
                       Foreground="{DynamicResource BrewTextPrimaryBrush}"
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       LetterSpacing="1"
                       Margin="0,-8,0,0" />

            <!-- The whole layer fades during mode changes. Reclaim this slot outside card
                 mode so the clock is centered inside the orbit instead of meeting its icons. -->
            <StackPanel Spacing="12"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding IsCardMode}"
                        Opacity="{Binding CardOpacity}">
                <StackPanel.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.6" />
                    </Transitions>
                </StackPanel.Transitions>

                <Viewbox Classes="ambient-breathe"
                         Width="68" Height="68"
                         HorizontalAlignment="Center"
                         Margin="0,8,0,0"
                         RenderTransformOrigin="50%,50%">
                    <Viewbox.RenderTransform>
                        <ScaleTransform />
                    </Viewbox.RenderTransform>
                    <Path Data="{Binding HeroIcon, Converter={StaticResource AmbientIcon}}"
                          Stroke="{DynamicResource BrewTextPrimaryBrush}" StrokeThickness="1.4"
                          StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
                </Viewbox>

                <TextBlock Text="{Binding Headline}"
                           Classes="brew-title ambient-headline"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />

                <TextBlock Text="{Binding Subheadline}"
                           Classes="brew-subtitle"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Opacity="0.85"
                           MaxWidth="520" />
            </StackPanel>
        </StackPanel>

        <!-- Retro DVD-screensaver bounce. Position + edge opacity changes are driven from
             code-behind (needs live panel/text bounds); the VM only toggles visibility. -->
        <TextBlock x:Name="DvdLogo"
                   Text="{Binding DvdLogoText}"
                   IsVisible="{Binding IsDvdMode}"
                   FontSize="46"
                   FontWeight="Bold"
                   LetterSpacing="3"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Foreground="{DynamicResource BrewTextPrimaryBrush}">
            <TextBlock.RenderTransform>
                <TranslateTransform />
            </TextBlock.RenderTransform>
        </TextBlock>

        <TextBlock Text="{Binding TapHint}"
                   Classes="brew-subtitle"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,28"
                   Opacity="0.55"
                   FontSize="14" />
    </Panel>
</UserControl>
