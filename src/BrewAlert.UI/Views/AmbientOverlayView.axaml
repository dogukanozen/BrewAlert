<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BrewAlert.UI.ViewModels"
             xmlns:conv="using:BrewAlert.UI.Converters"
             x:Class="BrewAlert.UI.Views.AmbientOverlayView"
             x:DataType="vm:AmbientOverlayViewModel">

    <UserControl.Resources>
        <conv:AmbientFloatConverter x:Key="AmbientFloat" />
        <conv:AmbientPulseOpacityConverter x:Key="AmbientPulse" />
    </UserControl.Resources>

    <Panel>
        <!-- Static gradient — no per-frame redraw beyond transforms -->
        <Panel Background="#1a1a2e">
            <Panel Opacity="0.55">
                <Ellipse Width="420" Height="420"
                         Fill="#e07c24"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="-80,-100,0,0"
                         Opacity="0.18" />
                <Ellipse Width="360" Height="360"
                         Fill="#f0a500"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,-60,-80"
                         Opacity="0.14" />
            </Panel>
        </Panel>

        <!-- Floating brew icons (transform-only animation) -->
        <TextBlock Text="{Binding FloatIconA}"
                   FontSize="52"
                   Opacity="0.35"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="48,72,0,0"
                   RenderTransformOrigin="50%,50%">
            <TextBlock.RenderTransform>
                <TranslateTransform Y="{Binding AnimationPhase, Converter={StaticResource AmbientFloat}, ConverterParameter=0}" />
            </TextBlock.RenderTransform>
        </TextBlock>

        <TextBlock Text="{Binding FloatIconB}"
                   FontSize="44"
                   Opacity="0.28"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,120,56,0"
                   RenderTransformOrigin="50%,50%">
            <TextBlock.RenderTransform>
                <TranslateTransform Y="{Binding AnimationPhase, Converter={StaticResource AmbientFloat}, ConverterParameter=1}" />
            </TextBlock.RenderTransform>
        </TextBlock>

        <TextBlock Text="{Binding FloatIconC}"
                   FontSize="38"
                   Opacity="0.22"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,100"
                   RenderTransformOrigin="50%,50%">
            <TextBlock.RenderTransform>
                <TranslateTransform Y="{Binding AnimationPhase, Converter={StaticResource AmbientFloat}, ConverterParameter=2}" />
            </TextBlock.RenderTransform>
        </TextBlock>

        <!-- Pulsing halo behind hero -->
        <Border Width="220" Height="220"
                CornerRadius="110"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,-40,0,0"
                BorderBrush="{StaticResource BrewAccentBrush}"
                BorderThickness="3"
                Opacity="{Binding AnimationPhase, Converter={StaticResource AmbientPulse}}" />

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Margin="24,0"
                    MaxWidth="640">

            <TextBlock Text="{Binding ClockTime}"
                       FontSize="72"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrewTextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       LetterSpacing="2" />

            <TextBlock Text="{Binding HeroIcon}"
                       FontSize="64"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />

            <TextBlock Text="{Binding Headline}"
                       Classes="brew-title ambient-headline"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />

            <TextBlock Text="{Binding Subheadline}"
                       Classes="brew-subtitle"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Opacity="0.85"
                       MaxWidth="520" />
        </StackPanel>

        <TextBlock Text="{Binding TapHint}"
                   Classes="brew-subtitle"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,28"
                   Opacity="0.55"
                   FontSize="14" />
    </Panel>
</UserControl>
