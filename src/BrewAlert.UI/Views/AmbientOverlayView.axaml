<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BrewAlert.UI.ViewModels"
             xmlns:conv="using:BrewAlert.UI.Converters"
             x:Class="BrewAlert.UI.Views.AmbientOverlayView"
             x:DataType="vm:AmbientOverlayViewModel">

    <UserControl.Resources>
        <conv:AmbientFloatConverter x:Key="AmbientFloat" />
        <conv:AmbientDriftConverter x:Key="AmbientDrift" />
        <conv:AmbientIconConverter x:Key="AmbientIcon" />
    </UserControl.Resources>

    <!-- Smooth, compositor-driven idle motion (transform/opacity only, Pi-friendly). These
         run independently of the 500ms VM tick, so they never stutter with it. -->
    <UserControl.Styles>
        <!-- Concentric rings that slowly rotate around the hero icon. -->
        <Style Selector="Ellipse.ambient-ring-cw">
            <Style.Animations>
                <Animation Duration="0:0:32" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.ambient-ring-ccw">
            <Style.Animations>
                <Animation Duration="0:0:48" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Steam wisps that rise and fade on a loop above the hero. Staggered delays keep
             the three from puffing in unison. -->
        <Style Selector="Viewbox.ambient-wisp.delay-0">
            <Style.Animations>
                <Animation Duration="0:0:6" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="20" />
                    </KeyFrame>
                    <KeyFrame Cue="35%">
                        <Setter Property="Opacity" Value="0.22" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-70" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Viewbox.ambient-wisp.delay-2">
            <Style.Animations>
                <Animation Duration="0:0:6" Delay="0:0:2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="20" />
                    </KeyFrame>
                    <KeyFrame Cue="35%">
                        <Setter Property="Opacity" Value="0.22" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-70" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Viewbox.ambient-wisp.delay-4">
            <Style.Animations>
                <Animation Duration="0:0:6" Delay="0:0:4" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="20" />
                    </KeyFrame>
                    <KeyFrame Cue="35%">
                        <Setter Property="Opacity" Value="0.22" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-70" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Orbit mode: the ring spins one way while each icon counter-spins at the same rate,
             so the icons travel the circle but stay upright. Same duration + linear timing
             keeps the cancellation exact. -->
        <Style Selector="Grid.orbit-spin">
            <Style.Animations>
                <Animation Duration="0:0:26" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Viewbox.orbit-counter">
            <Style.Animations>
                <Animation Duration="0:0:26" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="-360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Hero icon "breathing" and the halo "pulse" are continuous compositor keyframe
             animations (SineEaseInOut), not sampled off the 500ms VM tick — so the scale and
             glow glide smoothly instead of stepping 8 times per cycle. -->
        <Style Selector="Viewbox.ambient-breathe">
            <Style.Animations>
                <Animation Duration="0:0:6" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.955" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.955" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.045" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.045" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.955" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.955" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.ambient-pulse">
            <Style.Animations>
                <Animation Duration="0:0:6" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.22" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.40" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.22" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Panel ClipToBounds="True">
        <!-- Layer 1: vertical gradient base. Bound to the rotating palette so the whole
             backdrop recolours per scene; BrushTransition crossfades the swap. -->
        <Border Background="{Binding BackgroundBrush}">
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:1.4" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <!-- Layer 2: large slow-drifting palette blobs — give the backdrop life without
             per-pixel work (transform + opacity only). Fill recolours with the palette. -->
        <Ellipse Width="640" Height="640"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-220,-260,0,0"
                 Opacity="0.5"
                 IsHitTestVisible="False"
                 Fill="{Binding HaloBrush}">
            <Ellipse.Transitions>
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:1.4" />
                </Transitions>
            </Ellipse.Transitions>
            <Ellipse.RenderTransform>
                <!-- The drift offset is resampled every 500ms VM tick; a 0.5s transition (matched
                     to the tick) interpolates between samples so the blob glides instead of
                     snapping in 8 steps per cycle. -->
                <TranslateTransform X="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=1:34}"
                                    Y="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=0:40}">
                    <TranslateTransform.Transitions>
                        <Transitions>
                            <DoubleTransition Property="X" Duration="0:0:0.5" />
                            <DoubleTransition Property="Y" Duration="0:0:0.5" />
                        </Transitions>
                    </TranslateTransform.Transitions>
                </TranslateTransform>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="580" Height="580"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-200,-200"
                 Opacity="0.55"
                 IsHitTestVisible="False"
                 Fill="{Binding GlowBottomBrush}">
            <Ellipse.Transitions>
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:1.4" />
                </Transitions>
            </Ellipse.Transitions>
            <Ellipse.RenderTransform>
                <TranslateTransform X="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=3:30}"
                                    Y="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=2:36}">
                    <TranslateTransform.Transitions>
                        <Transitions>
                            <DoubleTransition Property="X" Duration="0:0:0.5" />
                            <DoubleTransition Property="Y" Duration="0:0:0.5" />
                        </Transitions>
                    </TranslateTransform.Transitions>
                </TranslateTransform>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Layer 3: feathered corner glows, also palette-driven. -->
        <Ellipse Width="520" Height="520"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-160,-200,0,0"
                 IsHitTestVisible="False"
                 Fill="{Binding GlowTopBrush}">
            <Ellipse.Transitions>
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:1.4" />
                </Transitions>
            </Ellipse.Transitions>
        </Ellipse>
        <Ellipse Width="460" Height="460"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-140,-140"
                 IsHitTestVisible="False"
                 Fill="{Binding GlowBottomBrush}">
            <Ellipse.Transitions>
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:1.4" />
                </Transitions>
            </Ellipse.Transitions>
        </Ellipse>

        <!-- Floating brew icons & particles — font-independent vector line art (orbit-like
             drift, transform-only). Grouped so they vanish cleanly when the DVD bounce takes
             the stage. -->
        <Panel IsVisible="{Binding IsCardMode}">
        <Viewbox Width="52" Height="52"
                 Opacity="0.35"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="48,72,0,0"
                 RenderTransformOrigin="50%,50%">
            <Viewbox.RenderTransform>
                <TranslateTransform X="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=4:10}"
                                    Y="{Binding AnimationPhase, Converter={StaticResource AmbientFloat}, ConverterParameter=0}">
                    <TranslateTransform.Transitions>
                        <Transitions>
                            <DoubleTransition Property="X" Duration="0:0:0.5" />
                            <DoubleTransition Property="Y" Duration="0:0:0.5" />
                        </Transitions>
                    </TranslateTransform.Transitions>
                </TranslateTransform>
            </Viewbox.RenderTransform>
            <Path Data="{Binding FloatIconA, Converter={StaticResource AmbientIcon}}"
                  Stroke="{StaticResource BrewTextPrimaryBrush}" StrokeThickness="1.3"
                  StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
        </Viewbox>

        <Viewbox Width="44" Height="44"
                 Opacity="0.28"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,120,56,0"
                 RenderTransformOrigin="50%,50%">
            <Viewbox.RenderTransform>
                <TranslateTransform X="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=2:9}"
                                    Y="{Binding AnimationPhase, Converter={StaticResource AmbientFloat}, ConverterParameter=1}">
                    <TranslateTransform.Transitions>
                        <Transitions>
                            <DoubleTransition Property="X" Duration="0:0:0.5" />
                            <DoubleTransition Property="Y" Duration="0:0:0.5" />
                        </Transitions>
                    </TranslateTransform.Transitions>
                </TranslateTransform>
            </Viewbox.RenderTransform>
            <Path Data="{Binding FloatIconB, Converter={StaticResource AmbientIcon}}"
                  Stroke="{StaticResource BrewTextPrimaryBrush}" StrokeThickness="1.3"
                  StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
        </Viewbox>

        <Viewbox Width="38" Height="38"
                 Opacity="0.22"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Margin="0,0,0,100"
                 RenderTransformOrigin="50%,50%">
            <Viewbox.RenderTransform>
                <TranslateTransform X="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=5:11}"
                                    Y="{Binding AnimationPhase, Converter={StaticResource AmbientFloat}, ConverterParameter=2}">
                    <TranslateTransform.Transitions>
                        <Transitions>
                            <DoubleTransition Property="X" Duration="0:0:0.5" />
                            <DoubleTransition Property="Y" Duration="0:0:0.5" />
                        </Transitions>
                    </TranslateTransform.Transitions>
                </TranslateTransform>
            </Viewbox.RenderTransform>
            <Path Data="{Binding FloatIconC, Converter={StaticResource AmbientIcon}}"
                  Stroke="{StaticResource BrewTextPrimaryBrush}" StrokeThickness="1.3"
                  StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
        </Viewbox>

        <Viewbox Width="22" Height="22"
                 Opacity="0.20"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 Margin="120,0,0,0"
                 RenderTransformOrigin="50%,50%">
            <Viewbox.RenderTransform>
                <TranslateTransform X="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=6:8}"
                                    Y="{Binding AnimationPhase, Converter={StaticResource AmbientFloat}, ConverterParameter=3}">
                    <TranslateTransform.Transitions>
                        <Transitions>
                            <DoubleTransition Property="X" Duration="0:0:0.5" />
                            <DoubleTransition Property="Y" Duration="0:0:0.5" />
                        </Transitions>
                    </TranslateTransform.Transitions>
                </TranslateTransform>
            </Viewbox.RenderTransform>
            <Path Data="M12,3 C12.5,8 13,9 18,12 C13,15 12.5,16 12,21 C11.5,16 11,15 6,12 C11,9 11.5,8 12,3 Z"
                  Stroke="{StaticResource BrewAccentBrush}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
        </Viewbox>

        <Viewbox Width="20" Height="20"
                 Opacity="0.18"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Margin="0,0,160,40"
                 RenderTransformOrigin="50%,50%">
            <Viewbox.RenderTransform>
                <TranslateTransform X="{Binding AnimationPhase, Converter={StaticResource AmbientDrift}, ConverterParameter=1:7}"
                                    Y="{Binding AnimationPhase, Converter={StaticResource AmbientFloat}, ConverterParameter=4}">
                    <TranslateTransform.Transitions>
                        <Transitions>
                            <DoubleTransition Property="X" Duration="0:0:0.5" />
                            <DoubleTransition Property="Y" Duration="0:0:0.5" />
                        </Transitions>
                    </TranslateTransform.Transitions>
                </TranslateTransform>
            </Viewbox.RenderTransform>
            <Path Data="M12,3 C12,3 6,11 6,15 A6,6 0 0 0 18,15 C18,11 12,3 12,3 Z"
                  Stroke="{StaticResource BrewTextPrimaryBrush}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
        </Viewbox>
        </Panel>

        <!-- Pulsing halo: soft radial glow placed BELOW center so it hugs the hero
             icon, never the clock numbers. Recolours with the palette. -->
        <Ellipse Classes="ambient-pulse"
                 Width="320" Height="320"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="0,80,0,0"
                 IsHitTestVisible="False"
                 Fill="{Binding HaloBrush}">
            <Ellipse.Transitions>
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:1.4" />
                </Transitions>
            </Ellipse.Transitions>
        </Ellipse>

        <!-- Slowly counter-rotating dashed rings + rising steam wisps encircle the hero icon.
             Card mode only; pure compositor transforms so the Pi stays smooth. -->
        <Panel IsVisible="{Binding IsCardMode}">
            <Ellipse Classes="ambient-ring-cw"
                     Width="208" Height="208"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="0,92,0,0"
                     Opacity="0.16"
                     IsHitTestVisible="False"
                     Stroke="{StaticResource BrewTextPrimaryBrush}"
                     StrokeThickness="1.4"
                     StrokeDashArray="2,7"
                     RenderTransformOrigin="50%,50%">
                <Ellipse.RenderTransform>
                    <RotateTransform />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Classes="ambient-ring-ccw"
                     Width="150" Height="150"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="0,92,0,0"
                     Opacity="0.18"
                     IsHitTestVisible="False"
                     Stroke="{StaticResource BrewAccentBrush}"
                     StrokeThickness="1.2"
                     StrokeDashArray="1,9"
                     RenderTransformOrigin="50%,50%">
                <Ellipse.RenderTransform>
                    <RotateTransform />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Viewbox Classes="ambient-wisp delay-0"
                     Width="24" Height="24"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="0,40,0,0"
                     IsHitTestVisible="False">
                <Viewbox.RenderTransform>
                    <TranslateTransform />
                </Viewbox.RenderTransform>
                <Path Data="M3,8 H13 A3,3 0 1 0 10,5 M3,13 H17 A3,3 0 1 1 14,16 M3,18 H11"
                      Stroke="{StaticResource BrewTextPrimaryBrush}" StrokeThickness="1.4"
                      StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Classes="ambient-wisp delay-2"
                     Width="18" Height="18"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="64,30,0,0"
                     IsHitTestVisible="False">
                <Viewbox.RenderTransform>
                    <TranslateTransform />
                </Viewbox.RenderTransform>
                <Path Data="M12,3 C12.5,8 13,9 18,12 C13,15 12.5,16 12,21 C11.5,16 11,15 6,12 C11,9 11.5,8 12,3 Z"
                      Stroke="{StaticResource BrewAccentBrush}" StrokeThickness="1.6"
                      StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Classes="ambient-wisp delay-4"
                     Width="20" Height="20"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="0,48,76,0"
                     IsHitTestVisible="False">
                <Viewbox.RenderTransform>
                    <TranslateTransform />
                </Viewbox.RenderTransform>
                <Path Data="M3,8 H13 A3,3 0 1 0 10,5 M3,13 H17 A3,3 0 1 1 14,16 M3,18 H11"
                      Stroke="{StaticResource BrewTextPrimaryBrush}" StrokeThickness="1.4"
                      StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
        </Panel>

        <!-- DVD mode dims the lively backdrop so the bouncing logo reads clearly. Sits above
             the animated background but below the clock, so the clock stays bright and fixed. -->
        <Border Background="#000000"
                IsHitTestVisible="False"
                Opacity="{Binding DvdDimOpacity}">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.8" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <!-- Orbit mode: brew icons revolve around the clock. Sits below the clock panel so the
             icons sweep behind the time. Card text/particles are hidden in this mode. -->
        <Grid Classes="orbit-spin"
              IsVisible="{Binding IsOrbitMode}"
              Width="300" Height="300"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              IsHitTestVisible="False"
              RenderTransformOrigin="50%,50%">
            <Grid.RenderTransform>
                <RotateTransform />
            </Grid.RenderTransform>
            <Viewbox Classes="orbit-counter" Width="48" Height="48"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0.7"
                     RenderTransformOrigin="50%,50%">
                <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                <Path Data="{Binding OrbitIconA, Converter={StaticResource AmbientIcon}}"
                      Stroke="{StaticResource BrewTextPrimaryBrush}" StrokeThickness="1.3"
                      StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Classes="orbit-counter" Width="48" Height="48"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7"
                     RenderTransformOrigin="50%,50%">
                <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                <Path Data="{Binding OrbitIconB, Converter={StaticResource AmbientIcon}}"
                      Stroke="{StaticResource BrewAccentBrush}" StrokeThickness="1.3"
                      StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Classes="orbit-counter" Width="48" Height="48"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0.7"
                     RenderTransformOrigin="50%,50%">
                <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                <Path Data="{Binding OrbitIconC, Converter={StaticResource AmbientIcon}}"
                      Stroke="{StaticResource BrewTextPrimaryBrush}" StrokeThickness="1.3"
                      StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
            <Viewbox Classes="orbit-counter" Width="48" Height="48"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.7"
                     RenderTransformOrigin="50%,50%">
                <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                <Path Data="{Binding OrbitIconD, Converter={StaticResource AmbientIcon}}"
                      Stroke="{StaticResource BrewAccentBrush}" StrokeThickness="1.3"
                      StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
            </Viewbox>
        </Grid>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Margin="24,0"
                    MaxWidth="640">

            <TextBlock Text="{Binding ClockTime}"
                       FontSize="72"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrewTextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       LetterSpacing="2" />

            <!-- Card text fades out in DVD mode. Opacity (not IsVisible) keeps the layout
                 slot, so the clock above never shifts when the mode flips. -->
            <StackPanel Spacing="12"
                        HorizontalAlignment="Center"
                        Opacity="{Binding CardOpacity}">
                <StackPanel.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.6" />
                    </Transitions>
                </StackPanel.Transitions>

                <Viewbox Classes="ambient-breathe"
                         Width="68" Height="68"
                         HorizontalAlignment="Center"
                         Margin="0,8,0,0"
                         RenderTransformOrigin="50%,50%">
                    <Viewbox.RenderTransform>
                        <ScaleTransform />
                    </Viewbox.RenderTransform>
                    <Path Data="{Binding HeroIcon, Converter={StaticResource AmbientIcon}}"
                          Stroke="{StaticResource BrewTextPrimaryBrush}" StrokeThickness="1.4"
                          StrokeLineCap="Round" StrokeJoin="Round" Fill="{x:Null}" />
                </Viewbox>

                <TextBlock Text="{Binding Headline}"
                           Classes="brew-title ambient-headline"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />

                <TextBlock Text="{Binding Subheadline}"
                           Classes="brew-subtitle"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Opacity="0.85"
                           MaxWidth="520" />
            </StackPanel>
        </StackPanel>

        <!-- Retro DVD-screensaver bounce. Position + edge colour changes are driven from
             code-behind (needs live panel/text bounds); the VM only toggles visibility. -->
        <TextBlock x:Name="DvdLogo"
                   Text="{Binding DvdLogoText}"
                   IsVisible="{Binding IsDvdMode}"
                   FontSize="46"
                   FontWeight="Bold"
                   LetterSpacing="3"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Foreground="#f0a500">
            <TextBlock.RenderTransform>
                <TranslateTransform />
            </TextBlock.RenderTransform>
        </TextBlock>

        <TextBlock Text="{Binding TapHint}"
                   Classes="brew-subtitle"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,28"
                   Opacity="0.55"
                   FontSize="14" />
    </Panel>
</UserControl>
