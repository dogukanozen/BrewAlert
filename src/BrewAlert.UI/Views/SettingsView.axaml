<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BrewAlert.UI.ViewModels" xmlns:views="using:BrewAlert.UI.Views"
             xmlns:media="using:BrewAlert.UI.Media" x:Class="BrewAlert.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel" Classes="settings-page">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="SettingsLayout" Classes="settings-layout" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="30"
              RowSpacing="28" Margin="24" MaxWidth="1000" HorizontalAlignment="Stretch">
            <Border Classes="settings-section settings-appearance">
                <views:AppearanceSettingsView DataContext="{Binding Appearance}" />
            </Border>
            <Border Classes="settings-section settings-profiles">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding DurationSettingsTitle}" Classes="brew-section" />
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EditableProfileViewModel">
                                <StackPanel Spacing="6" Margin="0,0,0,16" IsVisible="{Binding !IsDeleted}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{Binding Name}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Content="{Binding DeleteButtonText}" Command="{Binding DeleteCommand}"
                                                Classes="brew-nav-btn" FontSize="12" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Button Content="-" Command="{Binding DecreaseTimeCommand}" Classes="brew-secondary" Width="44" Padding="0" />
                                        <TextBlock Text="{Binding DurationText}" Width="75" TextAlignment="Center" VerticalAlignment="Center" FontSize="15" />
                                        <Button Content="+" Command="{Binding IncreaseTimeCommand}" Classes="brew-secondary" Width="44" Padding="0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DeleteErrorText}" Classes="brew-subtitle" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding AddProfileText}" Classes="brew-subtitle" />
                    <TextBox Text="{Binding NewProfileName}" Watermark="{Binding ProfileNameWatermark}" />
                    <WrapPanel>
                        <Button Content="-" Command="{Binding DecreaseDurationCommand}" Width="44" Padding="0" Classes="brew-secondary" Margin="0,0,8,8" />
                        <TextBlock Text="{Binding NewProfileDuration}" Width="32" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,8,8" />
                        <Button Content="+" Command="{Binding IncreaseDurationCommand}" Width="44" Padding="0" Classes="brew-secondary" Margin="0,0,8,8" />
                        <Button Content="{Binding AddProfileText}" Command="{Binding AddProfileCommand}" IsEnabled="{Binding !IsBusy}"
                                Classes="brew-primary" Margin="0,0,0,8" />
                    </WrapPanel>
                    <Button Content="{Binding ResetButtonText}" Command="{Binding ResetProfilesCommand}" IsEnabled="{Binding !IsBusy}"
                            Classes="brew-secondary" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding LanguageLabel}" Classes="brew-section" Margin="0,8,0,0" />
                    <WrapPanel>
                        <Button Content="Türkçe" Command="{Binding SetLanguageCommand}" CommandParameter="Turkish"
                                Classes="theme-option" Classes.selected="{Binding IsTurkishLanguage}" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,0" />
                        <Button Content="English" Command="{Binding SetLanguageCommand}" CommandParameter="English"
                                Classes="theme-option" Classes.selected="{Binding !IsTurkishLanguage}" IsEnabled="{Binding !IsBusy}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Classes="settings-section settings-notifications">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding NotificationSettingsTitle}" Classes="brew-section" />
                    <WrapPanel>
                        <Button Content="Webhook" Command="{Binding SetProviderCommand}" CommandParameter="Webhook"
                                Classes="theme-option" Classes.selected="{Binding IsWebhookSelected}" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8" />
                        <Button Content="Graph" Command="{Binding SetProviderCommand}" CommandParameter="Graph"
                                Classes="theme-option" Classes.selected="{Binding IsGraphSelected}" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8" />
                        <Button Content="Console" Command="{Binding SetProviderCommand}" CommandParameter="Console"
                                Classes="theme-option" Classes.selected="{Binding IsConsoleSelected}" IsEnabled="{Binding !IsBusy}" Margin="0,0,0,8" />
                    </WrapPanel>
                    <StackPanel Spacing="10" IsVisible="{Binding IsWebhookSelected}">
                        <TextBlock Text="{Binding WebhookUrlLabel}" Classes="brew-subtitle" />
                        <TextBox Text="{Binding WebhookUrlInput}" Watermark="https://..." />
                        <Button Content="{Binding SaveWebhookUrlText}" Command="{Binding SaveWebhookUrlCommand}" Classes="brew-primary"
                                IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding WebhookHintText}" Classes="brew-subtitle" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding IsGraphSelected}">
                        <TextBlock Text="{Binding GraphStatusText}" Classes="brew-subtitle" />
                        <TextBlock Text="{Binding TenantId, StringFormat='Tenant ID: {0}'}" Classes="brew-subtitle" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ClientId, StringFormat='Client ID: {0}'}" Classes="brew-subtitle" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ChatId, StringFormat='Chat ID: {0}'}" Classes="brew-subtitle" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding GraphHintText}" Classes="brew-subtitle" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel>
                        <Button Content="{Binding TestConnectionText}" Command="{Binding TestConnectionCommand}" Classes="brew-secondary"
                                IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8" />
                        <Button Content="{Binding SendTestNotificationText}" Command="{Binding SendTestNotificationCommand}"
                                Classes="brew-secondary" IsEnabled="{Binding !IsBusy}" Margin="0,0,0,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" FontSize="13" />
                </StackPanel>
            </Border>
            <Border Classes="settings-section settings-updates">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding UpdateSettingsTitle}" Classes="brew-section" />
                    <TextBlock Text="{Binding VersionText}" Classes="brew-subtitle" />
                    <Button Content="{Binding CheckUpdatesButtonText}" Command="{Binding CheckForUpdatesCommand}"
                            IsEnabled="{Binding !IsBusy}" Classes="brew-secondary" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding UpdateStatusText}" Classes="brew-subtitle" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Network.Title}" Classes="brew-section" Margin="0,8,0,0" />
                    <TextBlock x:Name="NetworkName" Text="{Binding Network.NetworkText}" Classes="brew-subtitle" TextWrapping="Wrap" />
                    <TextBlock x:Name="NetworkAddress" Text="{Binding Network.AddressText}" Classes="brew-subtitle" TextWrapping="Wrap"
                               IsVisible="{Binding Network.AddressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
