<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BrewAlert.UI.ViewModels" x:Class="BrewAlert.UI.Views.AppearanceSettingsView"
             x:DataType="vm:AppearanceSettingsViewModel">
    <StackPanel Spacing="14" IsEnabled="{Binding !IsSaving}">
        <TextBlock Text="{Binding Title}" Classes="brew-section" />
        <WrapPanel>
            <Button Content="{Binding ObsidianText}" Classes="theme-option" Classes.selected="{Binding IsObsidian}"
                    Command="{Binding SetModeCommand}" CommandParameter="Obsidian" Margin="0,0,8,8" />
            <Button Content="{Binding PorcelainText}" Classes="theme-option" Classes.selected="{Binding IsPorcelain}"
                    Command="{Binding SetModeCommand}" CommandParameter="Porcelain" Margin="0,0,8,8" />
            <Button Content="{Binding SumiText}" Classes="theme-option" Classes.selected="{Binding IsSumi}"
                    Command="{Binding SetModeCommand}" CommandParameter="Sumi" Margin="0,0,8,8" />
            <Button Content="{Binding IbreText}" Classes="theme-option" Classes.selected="{Binding IsIbre}"
                    Command="{Binding SetModeCommand}" CommandParameter="Ibre" Margin="0,0,8,8" />
            <Button Content="{Binding AizomeText}" Classes="theme-option" Classes.selected="{Binding IsAizome}"
                    Command="{Binding SetModeCommand}" CommandParameter="Aizome" Margin="0,0,8,8" />
            <Button Content="{Binding WeeklyText}" Classes="theme-option" Classes.selected="{Binding IsWeekly}"
                    Command="{Binding SetModeCommand}" CommandParameter="Weekly" Margin="0,0,0,8" />
        </WrapPanel>
        <TextBlock Text="{Binding ActiveText}" Classes="brew-subtitle" />
        <TextBlock Text="{Binding Hint}" Classes="brew-subtitle" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Days}" IsVisible="{Binding IsWeekly}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DayThemeViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                  MinWidth="132" AutomationProperties.Name="{Binding Name}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThemeOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
</UserControl>
